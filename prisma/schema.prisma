// Schéma Prisma — source de vérité de la base.
// Prisma 7 : les URLs de connexion vivent dans `prisma.config.ts`
// (pooler pour l'app via DATABASE_URL, connexion directe pour les migrations
// via DIRECT_URL). Le bloc datasource ne porte plus que le provider.
// Voir CLAUDE.md §Prisma + Supabase.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Enums métier (spec §4) ---

enum Poste {
  PILIER
  TALONNEUR
  DEUXIEME_LIGNE
  TROISIEME_LIGNE
  DEMI_MELEE
  DEMI_OUVERTURE
  CENTRE
  AILIER
  ARRIERE
}

enum Objectif {
  MUSCULATION
  EXPLOSIVITE
  VITESSE
  ENDURANCE
  RETOUR_BLESSURE
}

enum Environnement {
  MAISON
  SALLE_COMPLETE
}

enum Saison {
  INTER_SAISON
  DEBUT_SAISON
  MILIEU_SAISON
  FIN_SAISON
}

enum Jour {
  LUNDI
  MARDI
  MERCREDI
  JEUDI
  VENDREDI
  SAMEDI
  DIMANCHE
}

// Profil joueur. `id` = identifiant de l'utilisateur Supabase (auth.users).
// L'autorisation est applicative : l'id provient toujours de getAuthUser(),
// jamais du client (cf. CLAUDE.md TIER 1).
model Profile {
  id              String        @id
  firstName       String
  position        Poste
  goal            Objectif
  sessionsPerWeek Int // 1..5 (borné par Zod)
  sessionDuration Int // ∈ {30,45,60,90} (borné par Zod)
  environment     Environnement
  season          Saison
  trainingDays    Jour[]        @default([])
  matchDay        Jour?
  weeks           Week[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

// Statut d'une séance dans le tableau de bord (spec §5).
enum SessionStatus {
  A_FAIRE
  EN_COURS
  TERMINEE
}

// Programme d'une semaine pour un profil. La « semaine courante » est celle
// dont le weekNumber est le plus élevé.
model Week {
  id         String    @id @default(cuid())
  profileId  String
  profile    Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  weekNumber Int
  sessions   Session[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([profileId, weekNumber])
  @@index([profileId])
}

// Séance d'une semaine. Volontairement minimal au jalon dashboard
// (name/order/status) ; le contenu détaillé (objectif, durée, exercices — spec §6)
// arrivera avec le jalon programme via migration.
model Session {
  id        String        @id @default(cuid())
  weekId    String
  week      Week          @relation(fields: [weekId], references: [id], onDelete: Cascade)
  name      String
  order     Int
  status    SessionStatus @default(A_FAIRE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([weekId])
}
