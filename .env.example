# Copier en `.env` et renseigner les vraies valeurs. NE JAMAIS committer `.env`.
# Voir CLAUDE.md §Prisma + Supabase.

# --- Base de données (Supabase) ---
# App : pooler (transaction mode, port 6543).
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Migrations Prisma : connexion directe (port 5432).
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-region.pooler.supabase.com:5432/postgres"

# --- Supabase Auth (exposé au client) ---
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
# Clé publishable (sb_publishable_...). Remplace l'ancienne "anon key".
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"

# --- App ---
# URL publique du site (redirections d'emails Supabase : confirmation, reset).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
